# Copy this file to .env and fill in values

# ── Database ──────────────────────────────────────────────────────────────
# Local (docker-compose):
DATABASE_URL=postgresql+asyncpg://glitr:glitr@db:5432/glitrdb
# Neon.tech (production):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/glitrdb?ssl=require

# ── Groq LLM (required) ──────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXX

# ── Image backend ─────────────────────────────────────────────────────────
# "pollinations" — no key, rate-limited ~1 req/15s (default)
# "comfyui"     — requires COMFYUI_URL below
IMAGE_BACKEND=pollinations

# ── ComfyUI (only needed when IMAGE_BACKEND=comfyui) ─────────────────────
# The cloudflared tunnel URL printed by comfyui_setup.ipynb cell 8.
# ⚠️  This URL changes every time the Colab runtime restarts — update it then.
COMFYUI_URL=https://xxxx-xxxx-xxxx.trycloudflare.com

# ── Optional ──────────────────────────────────────────────────────────────
PORT=8000
